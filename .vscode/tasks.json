{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP32: Upload and restart",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m", "mpremote", "connect", "auto", "sleep", "2",
        "cp", "device/mavlink_rx.py", ":mavlink_rx.py", "+",
        "cp", "device/main.py", ":main.py", "+",
        "reset"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "ESP32: Monitor",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "mpremote", "connect", "auto", "repl"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "ESP32: List USB devices",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "mpremote", "connect", "list"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
